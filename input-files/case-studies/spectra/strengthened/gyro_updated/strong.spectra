guarantee -- not_ready_implies_stopped
	G((isReady=false->(((balancer_fwd=false&balancer_bwd=false)&balancer_turn_left=false)&balancer_turn_right=false)));

guarantee -- safety_requirement
	G((isReady=true->balancer_fwd=false));

guarantee -- goal_of_gyro
	GF(balancer_fwd=true);

guarantee -- clear_and_ready_implies_forward
	G(((distSense_blocked=false&isReady=true)->balancer_fwd=true));

guarantee -- forward_implies_next_not_turning
	G((balancer_fwd=true->next((balancer_turn_right=false&balancer_turn_left=false))));

guarantee -- blocked_and_stopped_and_ready_implies_next_moves
	G((((((balancer_fwd=false&balancer_bwd=false)&balancer_turn_left=false)&balancer_turn_right=false)&isReady=true)->(((next(balancer_fwd=true)|next(balancer_bwd=true))|next(balancer_turn_left=true))|next(balancer_turn_right=true))));

