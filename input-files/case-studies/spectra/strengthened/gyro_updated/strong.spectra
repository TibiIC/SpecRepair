module GyroAspect

sys boolean balancer_bwd;
sys boolean balancer_fwd;
sys boolean balancer_turn_left;
sys boolean balancer_turn_right;
env boolean distSense_blocked;
env boolean isReady;


assumption -- initially_not_ready
	isReady=false;

assumption -- ready_infinitely_often
	G(isReady=true);

assumption -- ready_stays_ready
	G((isReady=true->next(isReady=true)));

assumption -- turning_or_backward_leads_to_clear
	G((((balancer_bwd=true|balancer_turn_left=true)|balancer_turn_right=true)->F(distSense_blocked=false)));

guarantee -- initial_state
	(((balancer_fwd=false&balancer_bwd=false)&balancer_turn_left=false)&balancer_turn_right=false);

