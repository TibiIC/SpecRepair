module ColorSort

env boolean ack_bot_move;
env boolean ack_ver_hor_move;
env boolean atEdge_noedge;
sys boolean botMot_left;
sys boolean botMot_right;
sys boolean botMot_stop;
env boolean color_black;
env boolean color_blue;
env boolean color_green;
env boolean color_red;
env boolean color_yellow;
env boolean detect_black;
env boolean detect_blue;
env boolean detect_green;
env boolean detect_red;
env boolean detect_yellow;
env boolean haltButton_press;
sys boolean horMot_move;
sys boolean motSpeed_level1;
sys boolean motSpeed_level2;
env boolean num_of_cubes_zero;
sys boolean reduce_num_of_cubes_reduce;
sys boolean spec_allsleep;
sys boolean spec_currentColor_black;
sys boolean spec_currentColor_blue;
sys boolean spec_currentColor_green;
sys boolean spec_currentColor_red;
sys boolean spec_currentColor_yellow;
sys boolean spec_finished_cycle;
sys boolean spec_haltButtonValidPressed;
sys boolean spec_pausing_pause;
sys boolean spec_speedButtonValidPressed;
sys boolean spec_stage_drop;
sys boolean spec_stage_kick;
sys boolean spec_stage_toangleleft;
sys boolean spec_stage_toangleright;
sys boolean spec_stage_wait;
env boolean speedButton_press;
sys boolean verMot_move;


guarantee -- unnamed_guarantee_1
	G(((((haltButton_press=true&spec_haltButtonValidPressed=true)&PREV(haltButton_press=false))|(!(haltButton_press=true)&!(spec_haltButtonValidPressed=true)))|(!(PREV(haltButton_press=false))&!(spec_haltButtonValidPressed=true))));

guarantee -- unnamed_guarantee_2
	G((((spec_haltButtonValidPressed=true&spec_pausing_pause=false)|(spec_haltButtonValidPressed=false&spec_pausing_pause=true))->next(spec_pausing_pause=true)));

guarantee -- unnamed_guarantee_3
	G((((spec_haltButtonValidPressed=false&spec_pausing_pause=false)|(spec_haltButtonValidPressed=true&spec_pausing_pause=true))->next(spec_pausing_pause=false)));

guarantee -- no pause is eternal
	G(((spec_haltButtonValidPressed=true&spec_pausing_pause=false)->F(spec_haltButtonValidPressed=true)));

guarantee -- if we pause, this means no motors move and all the rest of the stats remain the same
	G(((spec_pausing_pause=true|ack_ver_hor_move=true)->(((((((spec_allsleep=true&spec_stage_wait=true)&next(spec_stage_wait=true))|((spec_allsleep=true&spec_stage_kick=true)&next(spec_stage_kick=true)))|((spec_allsleep=true&spec_stage_toangleright=true)&next(spec_stage_toangleright=true)))|((spec_allsleep=true&spec_stage_toangleleft=true)&next(spec_stage_toangleleft=true)))|((spec_allsleep=true&spec_stage_drop=true)&next(spec_stage_drop=true)))|((((((spec_allsleep=true&spec_stage_wait=false)&spec_stage_kick=false)&spec_stage_toangleright=false)&spec_stage_toangleleft=false)&spec_stage_drop=false)&next(((((spec_stage_wait=false&spec_stage_kick=false)&spec_stage_toangleright=false)&spec_stage_toangleleft=false)&spec_stage_drop=false))))));

guarantee -- aside from the WAIT stage, spec_currentColor never changes
	G((spec_stage_wait=false->((((((next(spec_currentColor_red=true)&spec_currentColor_red=true)|(next(spec_currentColor_green=true)&spec_currentColor_green=true))|(next(spec_currentColor_blue=true)&spec_currentColor_blue=true))|(next(spec_currentColor_black=true)&spec_currentColor_black=true))|(next(spec_currentColor_yellow=true)&spec_currentColor_yellow=true))|(next(((((spec_currentColor_red=false&spec_currentColor_green=false)&spec_currentColor_blue=false)&spec_currentColor_black=false)&spec_currentColor_yellow=false))&((((spec_currentColor_red=false&spec_currentColor_green=false)&spec_currentColor_blue=false)&spec_currentColor_black=false)&spec_currentColor_yellow=false)))));

guarantee -- only one motors moves at a time
	G((verMot_move=true->(botMot_stop=true&horMot_move=false)));

guarantee -- unnamed_guarantee_4
	G((horMot_move=true->(botMot_stop=true&verMot_move=false)));

guarantee -- unnamed_guarantee_5
	G((botMot_stop=false->(verMot_move=false&horMot_move=false)));

guarantee -- spec_allsleep is true iff all motors sleep
	G(((((((spec_allsleep=true&verMot_move=false)&horMot_move=false)&botMot_stop=true)|(!(spec_allsleep=true)&!(verMot_move=false)))|(!(spec_allsleep=true)&!(horMot_move=false)))|(!(spec_allsleep=true)&!(botMot_stop=true))));

guarantee -- motors are asleep at the start
	((motSpeed_level1=true&spec_stage_wait=true)&spec_pausing_pause=false);

guarantee -- if there is no cube and we are not currently moving a cube, all motors sleep
	G((((color_black=true&spec_stage_wait=true)|(num_of_cubes_zero=true&spec_stage_wait=true))->(spec_allsleep=true&next(spec_stage_wait=true))));

guarantee -- once seeing a cube, verMot kicks it in
	G(((((color_black=false&num_of_cubes_zero=false)&spec_stage_wait=true)&spec_pausing_pause=false)->(((((((verMot_move=true&color_red=true)&next((spec_currentColor_red=true&spec_stage_kick=true)))|((verMot_move=true&color_green=true)&next((spec_currentColor_green=true&spec_stage_kick=true))))|((verMot_move=true&color_blue=true)&next((spec_currentColor_blue=true&spec_stage_kick=true))))|((verMot_move=true&color_black=true)&next((spec_currentColor_black=true&spec_stage_kick=true))))|((verMot_move=true&color_yellow=true)&next((spec_currentColor_yellow=true&spec_stage_kick=true))))|((((((verMot_move=true&color_red=false)&color_green=false)&color_blue=false)&color_black=false)&color_yellow=false)&next((((((spec_currentColor_red=false&spec_currentColor_green=false)&spec_currentColor_blue=false)&spec_currentColor_black=false)&spec_currentColor_yellow=false)&spec_stage_kick=true))))));

guarantee -- after the cube has been kicked in, move to the right angle
	G((((ack_ver_hor_move=false&spec_stage_kick=true)&spec_pausing_pause=false)->(botMot_right=true&next(spec_stage_toangleright=true))));

