guarantee -- unnamed_guarantee_7
	G(((((speedButton_press=true&spec_speedButtonValidPressed=true)&PREV(speedButton_press=false))|(!(speedButton_press=true)&!(spec_speedButtonValidPressed=true)))|(!(PREV(speedButton_press=false))&!(spec_speedButtonValidPressed=true))));

guarantee -- if the speed button is pressed, increase the speed by one level
	G(((spec_speedButtonValidPressed=true&PREV(motSpeed_level1=true))->motSpeed_level2=true));

guarantee -- if the speed button is pressed, increase the speed by one level (2)
